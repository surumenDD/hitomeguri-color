{
  "name": "color-script-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && node test/browser.mjs",
    "lint": "biome check .",
    "check": "tsc --noEmit && npm run lint && npm test && npm run test:production && npm run licenses",
    "test:browser": "node test/browser.mjs",
    "test:robustness": "node test/robustness.mjs",
    "test:production": "npm run build && node test/production.mjs",
    "test:compat": "node test/m4-browser.mjs",
    "test:loading": "node test/m4-loading.mjs",
    "test:performance:throttled": "node test/m4-performance.mjs",
    "test:showcase": "node test/showcase.mjs",
    "test:secrets": "node test/scan-history.mjs",
    "licenses": "node test/licenses.mjs",
    "test:matrix": "node test/validate-m2.mjs",
    "test:performance": "node test/performance-m2.mjs",
    "test:captures": "node test/capture-islands.mjs && node test/capture-ui.mjs"
  },
  "dependencies": {
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "@phosphor-icons/react": "2.1.10",
    "mp4-muxer": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
